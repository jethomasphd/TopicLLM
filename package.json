{
  "name": "topicllm",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:welcome": "node scripts/build-welcome.mjs",
    "dev": "wrangler dev --var CANONICAL_REDIRECTS:false",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "check": "node --test tests/*.test.mjs && node scripts/build.mjs && node scripts/check-site.mjs"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.5.438",
    "wrangler": "^4.162.0"
  }
}
