{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topicllm",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4o-2024-08-06",
    "LIVE_DEMO_ENABLED": "true",
    "GUIDE_ENABLED": "true",
    "OPERATOR_LLM_ENABLED": "false",
    "DEMO_DAILY_USD": "20",
    "DEMO_MONTHLY_USD": "620",
    "OPERATOR_DAILY_USD": "5",
    "OPERATOR_MONTHLY_USD": "5",
    "OPERATOR_VALIDATION_USD": "5",
    "DEMO_SESSION_CALLS": "200",
    "DEMO_IP_CALLS": "600",
    "DEMO_SITE_CALLS": "20000",
    "DEMO_CONCURRENT_CALLS": "8"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "OPERATOR_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTAS",
        "class_name": "DemoQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DemoQuota"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "topicllm.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.topicllm.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
